<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Authdog.Samples.Authn</RootNamespace>
    <AuthdogSdk Condition="'$(AuthdogSdk)' == ''">$(AUTHDOG_SDK)</AuthdogSdk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AuthdogSdk)/csharp/Authdog.Sdk.csproj" />
  </ItemGroup>
</Project>
